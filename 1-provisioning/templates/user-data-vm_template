#cloud-config
# user-data-vm_template (Final VM Linked Clone Provisioning)

hostname: $HNAME
preserve_hostname: true

users:
  - name: $VM_USER
    gecos: $FULL_NAME
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    groups: [$VM_GROUP]
    shell: /bin/bash
    ssh_authorized_keys:
      - $KEY

chpasswd:
  list: |
    $VM_USER:$VM_PASSWORD
  expire: False

