# cfg-vm_create.env
# Configuration profile for vm_create.sh
# templates/cfg-vm_create.env-example will create this file if it not exist

# --- QUANTITY & NAMING ---
VM_COUNT=3	# use 0 to create backing file only
NODE_TYPE="lab"
NAME_PREFIX="1"	# cloud-init instance-id

# --- HARDWARE SPECS ---
RAM=2048	# in MB
VCPUS=2
DISK_SIZE="20G"

# --- OS & VIRT-INSTALL TUNING ---
URL_BASE="https://dl.rockylinux.org/pub/rocky/9/images/x86_64"
BASE="Rocky-9-GenericCloud-Base.latest.x86_64.qcow2"
CHECK_FILE="CHECKSUM"
OS_VARIANT="rocky9"
BOOT_TYPE="uefi"
DISK_BUS="virtio"
GRAPHICS="none"

# --- NETWORK ---
NET_MODEL="virtio"
NET_NAME="netvm"	# name of the libvirt network
NET_SUB="192.168.250"
IP_START="101"
IP_END="199"
NET_MASK="255.255.255.0"

# --- DEFAULT OS USER CONFIGURATION ---
VM_USER="sysadmin"
VM_GROUP="wheel"
FULL_NAME="System Administrator"
